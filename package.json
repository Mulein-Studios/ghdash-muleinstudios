{
  "name": "gitdash-muleinstudios",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Mulein Studios site, built with GitDash.",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "scripts": {
    "db": "gitdash-pages build-db",
    "build": "npm run db && gitdash-pages fetch-browser-api && gitdash-pages publish-due && gitdash-pages studio-assets && gitdash-pages copy-media && gitdash-pages gitlab-comments && gitdash-fonts build && astro build && gitdash-pages finish && pagefind --site dist/client",
    "preview": "npx serve dist/client",
    "export-content": "gitdash-pages export-content data.db content",
    "test:e2e": "playwright test",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "7.0.0",
    "@digitaldefiance/gitdash-fonts": "^0.3.0",
    "@digitaldefiance/gitdash-team": "^0.2.0",
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/gitdash/releases/download/pages-v0.6.0/emdash-cms-admin-1.5.0.tgz",
    "@emdash-cms/plugin-color": "^0.2.1",
    "@emdash-cms/plugin-embeds": "^0.1.59",
    "@emdash-cms/plugin-field-kit": "^0.1.3",
    "@sqlite.org/sqlite-wasm": "3.50.4-build1",
    "astro": "7.4.12",
    "emdash": "1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@digitaldefiance/gitdash-pages": "^0.15.1",
    "@emdash-cms/plugin-webhook-notifier": "^0.2.3",
    "@playwright/test": "^1.63.0",
    "lightningcss": "1.33.0",
    "pagefind": "^1.6.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "overrides": {
    "@emdash-cms/admin": "https://github.com/Digital-Defiance/gitdash/releases/download/pages-v0.6.0/emdash-cms-admin-1.5.0.tgz"
  }
}
