---
export async function getStaticPaths() {
	const { getEmDashCollection } = await import("emdash");
	const { PAGE_SIZE, pageCursors, pageParam } = await import("../../utils/paginate");
	const cursors = await pageCursors((cursor) =>
		getEmDashCollection("posts", { orderBy: { published_at: "desc" }, limit: PAGE_SIZE, cursor }),
	);
	return cursors.map((cursor, i) => ({
		params: { page: pageParam(i + 1) },
		props: { cursor, page: i + 1, totalPages: cursors.length },
	}));
}

import { getEmDashCollection, getTermsForEntries } from "emdash";
import { PAGE_SIZE } from "../../utils/paginate";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const { cursor, page, totalPages } = Astro.props;
const {
	entries: posts,
	cacheHint,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: PAGE_SIZE,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title="Music" description="Music by Mulein Studios">
	<header class="band intro">
		<div class="frame">
			<h1 class="intro__title">Music</h1>
		</div>
	</header>

	<section class="band section archive-band">
		<div class="frame">
			{
				posts.length === 0 ? (
					<div class="empty-state">
						<h2 class="empty-state__title">
							No posts yet
						</h2>
						<p class="empty-state__text">
							Published posts will show up here.
						</p>
					</div>
				) : (
					<>
						<ol class="archive__list post-grid">
							{postsWithTags.map(({ post, tags }) => (
								<li>
									<PostCard post={post} tags={tags} />
								</li>
							))}
						</ol>
						<Pagination
							basePath="/posts"
							page={page}
							totalPages={totalPages}
						/>
					</>
				)
			}
		</div>
	</section>
</Base>

<style>
	/* The band's rule doubles as the first row divider */
	.archive-band {
		padding-block-start: 0;
	}

	.archive__list {
		list-style: none;
	}

</style>
