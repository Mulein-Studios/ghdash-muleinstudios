---
export async function getStaticPaths() {
	const { getEmDashCollection } = await import("emdash");
	const { entries } = await getEmDashCollection("posts", { limit: 1000 });
	return entries.map((e) => ({ params: { slug: e.id } }));
}

import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Giscus from "../../components/Giscus.astro";
import GitLabComments from "../../components/GitLabComments.astro";
import Base from "../../layouts/Base.astro";
import { commentsProvider } from "../../utils/comments.mjs";
import { formatDate } from "../../utils/locale";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { siteUrl } from "../../utils/site-url";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const { title, excerpt, featured_image: artwork, publishedAt, bylines, terms } = post.data;
const origin = Astro.site ?? Astro.url.origin;
const storageKey = artwork?.meta?.storageKey;
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname,
	defaultOgImage: typeof storageKey === "string"
		? siteUrl(origin, `/media/${encodeURIComponent(storageKey)}`)
		: artwork?.src,
});
const provider = commentsProvider();
const authorNames = bylines?.map(({ byline }) => byline.displayName).join(", ");
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedAt?.toISOString()}
	modifiedTime={post.data.updatedAt.toISOString()}
	author={authorNames}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="frame record" data-pagefind-body>
		<header class="record__header">
			{terms?.category?.map((term) => (
				<a class="chip" href={`/category/${term.slug}/`}>{term.label}</a>
			))}
			<h1 {...post.edit.title}>{title}</h1>
			<p class="record__credit">
				{authorNames}
				{publishedAt && (
					<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "long")}</time>
				)}
			</p>
		</header>
		{artwork && (
			<figure class="record__artwork" {...post.edit.featured_image}>
				<Image image={artwork} priority />
			</figure>
		)}
		<div class="prose record__body" {...post.edit.content}>
			{excerpt && <p {...post.edit.excerpt}>{excerpt}</p>}
			<PortableText value={post.data.content} />
		</div>
		{provider && (
			<section class="record__body" aria-labelledby="comments-title">
				<h2 id="comments-title">Discussion</h2>
				{provider === "gitlab" ? <GitLabComments term={post.id} /> : <Giscus term={post.id} />}
			</section>
		)}
	</article>
</Base>

<style>
	.record {
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(4rem, 7vw, 6rem);
	}
	.record__header {
		max-width: var(--content-width);
		margin-inline: auto;
		text-align: center;
	}
	.record__header h1 {
		font-size: clamp(2.1rem, 5vw, 3rem);
		margin-block: 1rem;
	}
	.record__credit {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem 0.85rem;
		color: var(--color-text-secondary);
		font-size: var(--font-size-sm);
	}
	.record__artwork {
		max-width: var(--content-width);
		margin: 2rem auto 0;
	}
	.record__artwork :global(img) {
		width: 100%;
	}
	.record__body {
		max-width: var(--content-width);
		margin: 2.5rem auto 0;
	}
</style>
