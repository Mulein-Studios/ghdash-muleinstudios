---
export async function getStaticPaths() {
	const { getEmDashCollection } = await import("emdash");
	const { entries } = await getEmDashCollection("pages", { limit: 1000 });
	return entries.filter((e) => e.id !== "home").map((e) => ({ params: { slug: e.id } }));
}

import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class:list={["page", { "page--portfolio": slug === "portfolio" }]} data-pagefind-body>
		<div class="frame page__layout">
			<header class="page__header">
				<h1 class="page__title" {...page.edit.title}>{page.data.title}</h1>
			</header>

			<div class="prose page__body" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</div>
		</div>
	</article>
</Base>

<style>
	.page {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.page__layout {
		max-width: calc(var(--content-width) + 2 * var(--frame-padding));
	}

	.page__title {
		font-size: var(--font-size-display);
		margin-block-end: 1.5rem;
	}

	.page--portfolio .page__layout {
		max-width: var(--wide-width);
	}

	.page--portfolio .page__body {
		max-width: none;
	}

	.page--portfolio :global(.emdash-columns) {
		align-items: center;
		margin-block: 2rem;
	}

	.page--portfolio :global(.emdash-columns h2) {
		margin-block-end: 0.5rem;
	}

	@media (max-width: 768px) {
		.page--portfolio :global(.emdash-columns) {
			align-items: start;
		}

		.page--portfolio :global(.emdash-columns img) {
			max-width: 11rem;
		}
	}
</style>
