---
import { getEmDashEntry, getSiteSettings, type PortableTextImageBlock } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import "../styles/prose.css";

const [{ entry: home, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getSiteSettings(),
]);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);
const blocks = home?.data.content ?? [];
const first = blocks[0];
const hero = first?._type === "image" ? first as PortableTextImageBlock : undefined;
const mediaPrefix = "/_emdash/api/media/file/";
const heroUrl = hero?.asset.url;
const storageKey = heroUrl?.startsWith(mediaPrefix) ? heroUrl.slice(mediaPrefix.length) : undefined;
const heroImage = hero && {
	id: hero.asset._ref,
	src: storageKey ? undefined : heroUrl,
	meta: storageKey ? { storageKey } : undefined,
	alt: hero.alt || siteTitle,
	width: hero.width,
	height: hero.height,
};
const body = hero ? blocks.slice(1) : blocks;
---

<Base
	title={siteTitle}
	description={siteTagline}
	content={home ? { collection: "pages", id: home.data.id, slug: home.id } : undefined}
	home
>
	{heroImage && (
		<div class="frame home-banner">
			<Image image={heroImage} priority />
		</div>
	)}
	<div class="frame studio-home prose" data-pagefind-body {...home?.edit.content}>
		<PortableText value={body} />
	</div>
</Base>

<style>
	.home-banner {
		padding-block-start: clamp(1rem, 2.5vw, 1.75rem);
	}
	.home-banner :global(img) {
		width: min(100%, 620px);
		height: clamp(19rem, 41vw, 430px);
		object-fit: cover;
		margin-inline: auto;
	}
	.studio-home {
		max-width: none;
		padding-block: clamp(3rem, 7.5vw, 6.5rem);
		font-size: 1.0625rem;
		line-height: 1.6;
	}
	.studio-home :global(h1) {
		font-size: clamp(2.2rem, 4vw, 3rem);
		line-height: 1.125;

	}
	.studio-home :global(h2) {
		font-size: 1.25rem;
	}
	.studio-home :global(.emdash-columns) {
		margin-block-start: clamp(2.5rem, 4vw, 4rem);
	}
	.studio-home :global(.emdash-column > h2) {
		margin-block: 1rem 0.75rem;
	}
	.studio-home :global(.emdash-column > figure img) {
		width: 100%;
	}
	.studio-home :global(.emdash-column > :last-child) {
		margin-block-end: 0;
	}
</style>
